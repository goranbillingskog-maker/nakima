{
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/magasin/vad-kostar-en-naprapat-2026",
      "destination": "/magasin/vad-kostar-en-naprapat",
      "permanent": true
    },
    {
      "source": "/magasin/guide/naprapat-kiropraktor-eller-fysioterapeut",
      "destination": "/magasin/naprapat-kiropraktor-eller-fysioterapeut",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|images/|favicon.ico|favicon.png|robots.txt|llms.txt).*)",
      "destination": "/api/index"
    }
  ]
}
